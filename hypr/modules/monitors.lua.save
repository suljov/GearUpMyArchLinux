---- MONITORS ----
------------------

-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
hl.monitor({
    output   = "DP-2",
    mode     = "1920x1080@300.00Hz",
    position = "0x0",
--    scale    = "1.0",
})

-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
hl.monitor({
    output   = "DP-1",
    mode     = "1920x1080@1920x1080@60.00Hz",
    position = "1920x0",
   scale    = "1.0",
})
